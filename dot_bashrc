#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# iNiR environment
export INIR_VENV="/home/rahi/.local/state/quickshell/.venv"
export ILLOGICAL_IMPULSE_VIRTUAL_ENV="$INIR_VENV"
# Apply terminal color sequences (Material You from wallpaper)
if [ -f ~/.local/state/quickshell/user/generated/terminal/sequences.txt ]; then
  cat ~/.local/state/quickshell/user/generated/terminal/sequences.txt
fi
# end iNiR

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path bash)"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/rahi/miniforge3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/rahi/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/rahi/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/rahi/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# iNiR launcher PATH
case ":$PATH:" in
  *:"/home/rahi/.local/bin":*) ;;
  *) export PATH="/home/rahi/.local/bin:$PATH" ;;
esac
# end iNiR launcher PATH

. "$HOME/.cargo/env"
export PATH="$HOME/.local/bin:$PATH"
